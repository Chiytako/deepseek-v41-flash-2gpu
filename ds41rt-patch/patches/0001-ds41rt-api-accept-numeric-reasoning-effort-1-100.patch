+/// Parse `reasoning_effort` with the same rules as the native V4.1 adapter:
+/// level names (case-insensitive; `none`/`off`/`disabled` disable thinking) or
+/// an explicit 1-100 score given as an integer or a numeric string.
+pub(crate) fn parse_reasoning_effort(
+    value: &Value,
+) -> Result<Option<deepseek_recipe_core::conversation::ReasoningEffort>, String> {
+    use deepseek_recipe::openai::chat_completion::request::ChatCompletionReasoningEffort as Requested;
+    use deepseek_recipe_core::conversation::ReasoningEffort;
+    let requested: Requested = serde_json::from_value(value.clone()).map_err(|e| e.to_string())?;
+    Ok(match requested {
+        Requested::None => None,
+        Requested::Minimal | Requested::Low => Some(ReasoningEffort::Low),
+        // medium/xhigh: local extension (62/88); the official mapping is 75.
+        Requested::Medium => Some(ReasoningEffort::Budget(ReasoningEffort::MEDIUM_SCORE)),
+        Requested::High => Some(ReasoningEffort::High),
+        Requested::Xhigh => Some(ReasoningEffort::Budget(ReasoningEffort::XHIGH_SCORE)),
+        Requested::Max => Some(ReasoningEffort::Max),
+        Requested::Budget(score) => Some(ReasoningEffort::Budget(score)),
+    })
+}
