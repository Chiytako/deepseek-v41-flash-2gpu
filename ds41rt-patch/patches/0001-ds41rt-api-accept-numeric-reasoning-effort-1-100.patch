+    #[test]
+    fn reasoning_effort_accepts_scores_and_maps_them_to_the_nearest_ds4_level() {
+        let request = |effort: serde_json::Value| -> ChatCompletionRequest {
+            serde_json::from_value(serde_json::json!({
+                "model": "test",
+                "messages": [{"role": "user", "content": "hello"}],
+                "thinking": {"type": "enabled"},
+                "reasoning_effort": effort
+            }))
+            .unwrap()
+        };
+        let high = "<｜begin▁of▁sentence｜>Reasoning Effort: Absolute maximum";
+        let max = "<｜begin▁of▁sentence｜>Reasoning Effort: Beyond maximum";
+        for (effort, prefix) in [
+            (serde_json::json!(75), Some(high)),
+            (serde_json::json!("80"), Some(high)),
+            (serde_json::json!(95), Some(max)),
+            (serde_json::json!("xhigh"), Some(high)),
+            (serde_json::json!("medium"), Some(high)),
+            (serde_json::json!(62), Some(high)),
+            (serde_json::json!(88), Some(high)),
+            (serde_json::json!(89), Some(max)),
+            (serde_json::json!(61), None),
+            (serde_json::json!(40), None),
+            (serde_json::json!("low"), None),
+        ] {
+            let request = request(effort.clone());
+            validate_request(&request).unwrap();
+            let prompt = real_ds4_full_request_prompt_text(&request);
+            match prefix {
+                Some(prefix) => assert!(prompt.starts_with(prefix), "{effort}"),
+                None => assert!(!prompt.contains("Reasoning Effort:"), "{effort}"),
+            }
+        }
+        for effort in [
+            serde_json::json!(0),
+            serde_json::json!(101),
+            serde_json::json!(2.5),
+            serde_json::json!("abc"),
+        ] {
+            let error = validate_request(&request(effort.clone())).unwrap_err();
+            assert!(format!("{error:?}").contains("integer from 1 to 100"), "{effort}");
+        }
+    }
